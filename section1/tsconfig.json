{
    // 배열내 문자에 해당하는 폴더의 하위에 있는 ts파일을 자동으로 선택
    "include": ["src"],

    "compilerOptions": {
        // 컴파일되는 js파일의 버전
        "target": "ESNext",
        // export, import 모듈시스템의 버전
        "module": "ESNext",
        // 컴파일결과 생성될 js파일의 위치
        "outDir": "dist",
        // 엄격한 타입검사
        "strict": false,
        // 자동으로 모듈시스템을 사용하는 파일로 변환
        "moduleDetection": "force",
        // 엄격한 null 검사 (null타입이 아닌 변수에 null을 저장하게 할것인지)
        "strictNullChecks": false,


        "skipLibCheck": true
    },


}